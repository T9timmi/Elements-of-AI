import turtle
import time

def setup_canvas():
    screen = turtle.Screen()
    screen.title("AI Sunset Painter")
    screen.bgcolor("black")
    screen.setup(width=800, height=600)
    return screen

def draw_rectangle(t, color, x, y, width, height):
    t.penup()
    t.goto(x, y)
    t.pendown()
    t.color(color)
    t.begin_fill()
    for _ in range(2):
        t.forward(width)
        t.left(90)
        t.forward(height)
        t.left(90)
    t.end_fill()

def draw_circle(t, color, x, y, radius):
    t.penup()
    t.goto(x, y - radius)
    t.pendown()
    t.color(color)
    t.begin_fill()
    t.circle(radius)
    t.end_fill()

def paint_sunset():
    screen = setup_canvas()
    artist = turtle.Turtle()
    artist.speed(0)  # Fastest drawing speed
    artist.hideturtle()

    print("🎨 AI Artist is painting the sky...")
    
    # 1. Paint Sky Layers (Gradient from dark purple to bright yellow)
    sky_colors = [
        "#2c003e",  # Dark Purple (top)
        "#511845",  # Deep Plum
        "#900c3f",  # Crimson
        "#c70039",  # Red
        "#f37121",  # Orange
        "#ffbd39"   # Bright Yellow (horizon)
    ]
    
    start_y = 300
    band_height = 60
    
    for color in sky_colors:
        draw_rectangle(artist, color, -400, start_y - band_height, 800, band_height)
        start_y -= band_height

    print("🌅 AI Artist is painting the glowing sun...")
    # 2. Paint Sun setting on the horizon
    draw_circle(artist, "#fff5a5", 0, -40, 70)

    print("🌊 AI Artist is painting the ocean...")
    # 3. Paint Ocean at the bottom
    draw_rectangle(artist, "#0f3460", -400, -300, 800, 240)

    print("✨ AI Artist is adding sun reflection on the water...")
    # 4. Paint Reflection stripes on water
    reflection_y = -70
    for width in [120, 90, 70, 50, 30, 15]:
        draw_rectangle(artist, "#f37121", -width / 2, reflection_y, width, 10)
        reflection_y -= 25

    print("🎨 Painting Complete! Enjoy your sunset!")
    
    # Keep the window open until clicked
    screen.exitonclick()

if __name__ == "__main__":
    paint_sunset()
