function updateImageLayers() {
  drawSunsetGraphics(sunsetImg);

  if (spongebobActive) {
    renderCharacterToLayer(sunsetImg);
  }

  invertImg.image(sunsetImg, 0, 0);
  invertImg.filter(INVERT);
}

function keyPressed() {
  if (key === 's' || key === 'S') {
    spongebobActive = !spongebobActive;
    updateImageLayers();

    if (spongebobActive) {
      mode = "reveal";
      console.log("🧽 SpongeBob + Big Pineapple Layer ADDED! Hover in Reveal mode to paint.");
    } else {
      console.log("🚫 SpongeBob Layer REMOVED!");
    }
  }

  if (key === ' ') {
    mode = "neutral";
    console.log("⏸️ Mode: Neutral");
  }

  if (key === 'r' || key === 'R') {
    mode = "reveal";
    console.log("🌅 Mode: Reveal");
  }

  if (key === 'i' || key === 'I') {
    mode = "invert";
    console.log("🔄 Mode: Invert");
  }

  if (key === 'e' || key === 'E') {
    mode = "erase";
    console.log("🧽 Mode: Erase");
  }

  if (key === 'c' || key === 'C') {
    spongebobActive = false;
    updateImageLayers();
    background(0);
    console.log("🧹 Canvas Cleared");
  }
}
