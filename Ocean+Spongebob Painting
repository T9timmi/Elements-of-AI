let mode = "neutral"; // Modes: 'reveal', 'invert', 'erase', 'neutral'
let sunsetImg;
let invertImg;
let brushMask;
let spongebobActive = false; // Tracks if SpongeBob layer is active

function setup() {
  createCanvas(400, 400);
  background(0); // Solid black canvas to start

  // 1. High-res original graphics layer
  sunsetImg = createGraphics(width, height);
  drawSunsetGraphics(sunsetImg);

  // 2. High-res pre-inverted layer
  invertImg = createGraphics(width, height);
  updateImageLayers();

  // 3. Circular mask buffer
  brushMask = createGraphics(50, 50);
  brushMask.noStroke();
  brushMask.fill(255);
  brushMask.ellipse(25, 25, 50, 50);

  console.log("Started in Neutral Mode. Press S to toggle SpongeBob layer, then R, I, or E to paint.");
}

function draw() {
  // Continuous brush painting on hover
  if (mouseX >= 0 && mouseX <= width && mouseY >= 0 && mouseY <= height) {
    if (mouseX !== pmouseX || mouseY !== pmouseY) {
      if (mode === "reveal") {
        stampBrush(sunsetImg, pmouseX, pmouseY, mouseX, mouseY);
      } else if (mode === "invert") {
        stampBrush(invertImg, pmouseX, pmouseY, mouseX, mouseY);
      } else if (mode === "erase") {
        stroke(0);
        strokeWeight(50);
        strokeCap(ROUND);
        line(pmouseX, pmouseY, mouseX, mouseY);
      }
    }
  }
}

// Brush stamping function
function stampBrush(sourceImg, px, py, x, y) {
  let d = dist(px, py, x, y);
  let steps = max(1, min(20, floor(d / 3)));

  for (let i = 0; i <= steps; i++) {
    let curX = lerp(px, x, i / steps);
    let curY = lerp(py, y, i / steps);

    let patch = sourceImg.get(curX - 25, curY - 25, 50, 50);
    patch.mask(brushMask);
    image(patch, curX - 25, curY - 25);
  }
}

// Base Sunset Scene
function drawSunsetGraphics(pg) {
  // Sky Gradient
  for (let y = 0; y <= 250; y++) {
    let inter = map(y, 0, 250, 0, 1);
    let c = lerpColor(color(44, 0, 62), color(243, 113, 33), inter);
    pg.stroke(c);
    pg.line(0, y, width, y);
  }

  // Glowing Sun
  pg.noStroke();
  for (let r = 90; r > 0; r -= 2) {
    let alphaVal = map(r, 0, 90, 255, 20);
    pg.fill(255, 245, 165, alphaVal);
    pg.ellipse(200, 180, r, r);
  }

  // Ocean
  pg.fill(15, 52, 96);
  pg.rect(0, 250, width, 150);

  // Ocean Reflections
  for (let w = 120; w > 0; w -= 10) {
    let alphaVal = map(w, 0, 120, 150, 10);
    pg.fill(255, 245, 165, alphaVal);
    pg.ellipse(200, 275, w, 8);
    pg.ellipse(200, 305, w * 1.3, 10);
    pg.ellipse(200, 335, w * 1.6, 12);
  }
}

