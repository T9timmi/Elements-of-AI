
import time
import random

# Color codes to make the terminal look awesome
GREEN = "\033[92m"
YELLOW = "\033[93m"
RED = "\033[91m"
RESET = "\033[0m"
BOLD = "\033[1m"

class FridgeItem:
    def __init__(self, name: str, days_left: int, category: str):
        self.name = name
        self.days_left = days_left
        self.category = category

    def get_status_badge(self):
        if self.days_left <= 0:
            return f"{RED}[EXPIRED / TOXIC]{RESET}"
        elif self.days_left <= 2:
            return f"{RED}[CRITICAL - USE NOW]{RESET}"
        elif self.days_left <= 4:
            return f"{YELLOW}[WARNING - SOON]{RESET}"
        else:
            return f"{GREEN}[FRESH]{RESET}"

def simulate_ai_scanning():
    print(f"\n{BOLD}🤖 Running FoodSaver AI Computer Vision Scan...{RESET}")
    scenery = ["Scanning barcode...", "Analyzing freshness spectrum...", "Checking fridge temp...", "Cross-referencing recipes..."]
    for step in scenery:
        time.sleep(0.4)
        print(f"  --> {step}")
    print(f"{GREEN}✔ Scan complete!{RESET}\n")

def cook_recipe(ingredients):
    print(f"\n{BOLD}👨‍🍳 AI CHEF IS COOKING...{RESET}")
    time.sleep(0.6)
    
    recipes = [
        ("Ultimate Rescue Stir-Fry", "Sauté everything in a wok with soy sauce and garlic!"),
        ("Everything-Must-Go Omelette", "Whisk with 3 eggs, throw in cheese, and fold in a hot pan!"),
        ("Zero-Waste Mystery Soup", "Boil in vegetable broth, season with herbs, and serve hot!")
    ]
    chosen_recipe = random.choice(recipes)
    
    print(f"✨ {BOLD}Recipe Unlocked: {chosen_recipe[0]}!{RESET}")
    print(f"📝 {BOLD}Instructions:{RESET} {chosen_recipe[1]}")
    print(f"🎉 Saved ingredients: {', '.join([i.name for i in ingredients])}")

def main():
    print("=" * 55)
    print(f"{BOLD}🥑 Welcome to FoodSaver AI: The Fridge Survival Game! 🥑{RESET}")
    print("=" * 55)

    # Initial Fridge Inventory
    inventory = [
        FridgeItem("Fresh Spinach", 1, "Produce"),
        FridgeItem("Whole Milk", 2, "Dairy"),
        FridgeItem("Avocado", 0, "Fruit"),
        FridgeItem("Cheddar Cheese", 8, "Dairy"),
        FridgeItem("Chicken Breast", 1, "Meat"),
    ]

    simulate_ai_scanning()

    # Display Inventory
    print(f"{BOLD}📦 YOUR CURRENT FRIDGE INVENTORY:{RESET}")
    print("-" * 50)
    for idx, item in enumerate(inventory, 1):
        print(f"{idx}. {item.name:<18} | {item.days_left} day(s) left | {item.get_status_badge()}")
    print("-" * 50)

    # AI identifies critical items
    critical_items = [item for item in inventory if 0 < item.days_left <= 2]

    if critical_items:
        print(f"\n🚨 {RED}{BOLD}ALERT:{RESET} You have {len(critical_items)} item(s) about to go bad!")
        print(f"Emergency AI Action Plan triggered for: {', '.join([i.name for i in critical_items])}")
        
        choice = input(f"\nDo you want FoodSaver AI to generate an emergency rescue meal? (y/n): ").lower()
        if choice == 'y':
            cook_recipe(critical_items)
            print(f"\n🏆 {GREEN}Success! You prevented food waste and saved roughly $12.50!{RESET}\n")
        else:
            print("\n🚨 Oh no! The food decayed into a biohazard! Game over!\n")
    else:
        print(f"\n{GREEN}Everything looks fresh! No immediate food waste risk detected.{RESET}\n")

if __name__ == "__main__":
    main()
